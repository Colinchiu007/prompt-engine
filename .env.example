# Prompt Engine 环境变量配置
# 复制此文件为 .env 并填入你的实际值

# LLM 供应商 (ai_router | xfyun | openai_compat | minimax)
LLM_PROVIDER=minimax
# 可选：指定自定义 YAML 配置文件
# CONFIG_PATH=D:\path\to\config.yaml

# AI Router 统一模型路由（将 LLM_PROVIDER 改为 ai_router 后启用）
AI_ROUTER_PROJECT_KEY=your_ai_router_project_key_here
AI_ROUTER_BASE_URL=https://ai-router.truevideo.top/v1
AI_ROUTER_MODEL=auto

# MiniMax 配置 (MiniMax-M3 模型)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_TIMEOUT=60

# 讯飞星火配置 (备用)
XFYUN_API_KEY=your_xfyun_api_key_here
XFYUN_BASE_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2
XFYUN_MODEL=astron-code-latest

# 分句服务（对比验证页使用；smart-sentence-splitter 默认端口 8002）
# SPLITTER_BASE_URL=http://127.0.0.1:8002

# OpenAI 兼容配置 (备用)
OPENAI_COMPAT_API_KEY=your_openai_compat_api_key_here
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_MODEL=anthropic/claude-sonnet-4-20250514
OPENAI_COMPAT_TIMEOUT=60

# OpsCenter 服务间认证（可选；缺少密钥时不会访问 OpsCenter）
# OPS_CENTER_URL=http://127.0.0.1:8010
# 非默认来源必须按 scheme://host:port 精确加入白名单，多个来源使用逗号分隔
# OPS_CENTER_ALLOWED_ORIGINS=https://ops.example.com:443
# PO_SECRET_KEY=replace_with_a_strong_service_secret_at_least_32_characters

# API Key 管理端点令牌（必须手动设置至少 32 个字符的随机值；未设置时管理端点会拒绝请求）
# PROMPT_ENGINE_ADMIN_TOKEN=

# MiMo TTS 音色克隆配置
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-tts-voiceclone
